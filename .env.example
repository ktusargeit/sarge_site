# ==========================================
# SARGE Web Portal - Environment Variables Template
# Kopyalayin: .env.example -> .env  (gercek degerleri .env'e yazin, .env git'e eklenmez)
# ==========================================

# 1. Admin kimlik bilgileri (kodda varsayilan DEGER YOKTUR; tanimlanmazsa admin girisi kapali kalir)
ADMIN_USERNAME="your-admin-username"
# Her kurulum icin benzersiz, rastgele ve uzun bir tuz (ornek: 64 hex karakter)
PASSWORD_SALT="RANDOM_64_HEX_CHARS"
# Sifrenin PBKDF2-SHA256 ozeti (100000 tur, 32 bayt, hex). Duz metin sifre tutmayin.
ADMIN_PASSWORD_HASH="PBKDF2_HASH_OF_YOUR_PASSWORD"

# 2. Oturum imza anahtari (uzun rastgele metin)
SESSION_SECRET="RANDOM_64_HEX_CHARS"

# 3. Gizli URL kapisi (/?yonetim=ANAHTAR). Yalnizca arayuzu gizler, guvenlik siniri degildir.
VITE_ADMIN_GATE_KEY="YOUR_SECRET_URL_GATE_KEY"

# 4. Firebase Admin SDK servis hesabi (veritabani yazmalari sadece sunucudan yapilir)
# Secenek A: dosya yolu
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# Secenek B: JSON'un tamami tek satirda (Render/Railway gibi ortam degiskeni kullanan servisler icin)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'

# 5. Proxy / gercek IP ayarlari
# Dogrudan internete aciksa 0; tek bir ters proxy (Nginx/Render/Railway) arkasindaysa 1
TRUST_PROXY_HOPS=0
# SADECE tum trafik Cloudflare uzerinden geciyorsa true
BEHIND_CLOUDFLARE=false

# 6. Gemini API anahtari
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 7. Uygulama adresi
APP_URL="YOUR_APP_URL"
